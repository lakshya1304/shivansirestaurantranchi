{
  "__meta__": {
    "project": "Maa Tara Sweets / Shivansi Restaurant Ranchi",
    "type": "FullStack Restaurant Management App"
  },
  "stack": {
    "frontend": ["React", "Vite", "TailwindCSS", "Tanstack Router", "React Query", "Shadcn UI"],
    "backend": ["Node.js", "Fastify", "Prisma"],
    "db": ["PostgreSQL", "Split schema: app.schema.prisma (Public) / admin.schema.prisma (Internal)"]
  },
  "auth": {
    "methods": ["WebAuthn / Passkeys", "Google OAuth (UI built, flow pending)", "Email OTP / Password"],
    "roles": ["USER", "ADMIN", "SUPERADMIN"],
    "middlewares": ["requireRole (Backend)", "auth-middleware.ts (Frontend)"]
  },
  "routes": {
    "frontend": {
      "public": ["/", "/menu", "/cart", "/login", "/signup", "/scanner", "/table/$tableNumber"],
      "customer_auth": ["/profile", "/my-orders"],
      "admin": [
        "/auth (Admin login only)",
        "/admin (Live Orders Board)",
        "/admin/reports (Revenue & Analytics)",
        "/admin/governance (Superadmin Actions: Create/Delete Admins)",
        "/admin/menu", "/admin/inventory", "/admin/customers", "/admin/staff", "/admin/settings"
      ]
    },
    "backend": {
      "prefix": "/api/v1",
      "modules": {
        "/auth": "Authentication (login, register, webauthn, totp)",
        "/data/orders": "Order lifecycle (place, status, payment, history)",
        "/data/catalog": "Products, Categories",
        "/data/governance": "AdminActionRequest, Votes, Superadmin creation/deletion",
        "/data/settings": "Restaurant metadata, global toggles",
        "/data/users": "User management"
      }
    }
  },
  "accomplishments": [
    {
      "feature": "Governance Module Fix",
      "action": "Fixed InternalServerError by changing user.userId to user.id in governance.controller.ts. Prevented target admins from voting on their own deletion requests."
    },
    {
      "feature": "Admin Auth UI",
      "action": "Added Passkey and Google login integration to the restricted admin `/auth` route."
    },
    {
      "feature": "Dashboard Re-organization",
      "action": "Moved Revenue Analytics out of admin.index.tsx (Live Kitchen) and into admin.reports.tsx (Revenue & Reports). Removed 'Revenue today' KPI from Live dashboard to fix UI mixup where order cards showed in revenue views."
    },
    {
      "feature": "Build & UI Fixes",
      "action": "Fixed missing format.ts exports (isThisMonth, isThisYear, isSameDay) causing black screens. Fixed missing IndianRupee lucide-react import."
    }
  ],
  "active_bugs_and_tasks": [
    {
      "issue": "Live Dashboard State Update Failure",
      "description": "Clicking state change buttons ('Mark ready to serve') in `admin.index.tsx` does not update the order state or UI.",
      "flow": "admin.index.tsx (setStatus) -> notify.functions.ts (updateOrderStatus) -> PATCH /data/orders/:id/status -> order.routes.ts -> order.controller.ts (updateOrderStatus)",
      "hypotheses": [
        "WhatsApp API (`sendWhatsAppMessage` in `order.controller.ts`) is throwing an unhandled exception which crashes the API request before 200 OK is sent.",
        "Prisma throws a P2025 error due to state mismatch.",
        "React Query `qc.invalidateQueries(['orders'])` is failing to re-fetch or WebSockets are not pushing updates correctly."
      ],
      "next_steps": [
        "Check Fastify backend logs immediately after clicking a state change button in the dashboard.",
        "Wrap `sendWhatsAppMessage` inside `order.controller.ts` in a try/catch block to prevent it from failing the state update transaction.",
        "Verify `broadcastOrderEvent` successfully emits the event to connected clients."
      ]
    },
    {
      "issue": "WhatsApp / Email Integrations",
      "status": "Pending full implementation. Brevo and WhatsApp API configurations exist but need verification."
    },
    {
      "issue": "Google OAuth Backend",
      "status": "UI added, backend logic needs to be connected for restricted Admin/Superadmin Google logins."
    }
  ]
}
