generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prismaApp"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PREPARED
  SERVED
  COMPLETED
  CANCELLED
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String? @unique
  password String  @map("hashed_password")
  role     Role

  avatarUrl String?

  isActive     Boolean  @default(true)
  lastLogin    DateTime @default(now())
  refreshToken String?

  totpSecret    String?
  isTotpEnabled Boolean @default(false)

  currentChallenge String?

  birthday       DateTime?
  visits         Int       @default(0)
  reward_points  Int       @default(0)
  total_spend    Float     @default(0)
  favourite_item String?
  saved_address  String?
  last_visit     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image_url   String?
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)

  products Product[]

  @@map("categories")
}

model Product {
  id              String  @id @default(uuid())
  category_id     String?
  category        Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  name            String
  description     String?
  image_url       String?
  price           Float
  offer_price     Float?
  rating          Float   @default(0)
  review_count    Int     @default(0)
  prep_time_mins  Int     @default(15)
  is_available    Boolean @default(true)
  is_veg          Boolean @default(true)
  is_spicy        Boolean @default(false)
  calories        Int     @default(0)
  is_special      Boolean @default(false)
  is_popular      Boolean @default(false)
  is_recommended  Boolean @default(false)
  sold_by_weight  Boolean @default(false)
  price_per_kg    Float?
  sort_order      Int     @default(0)

  orderItems OrderItem[]

  @@map("products")
}

model Offer {
  id               String    @id @default(uuid())
  title            String
  description      String?
  banner_url       String?
  discount_percent Float
  coupon_code      String?   @unique
  category_ids     String[]
  product_ids      String[]
  starts_at        DateTime?
  ends_at          DateTime?
  is_active        Boolean   @default(true)

  @@map("offers")
}

model Discount {
  id               String    @id @default(uuid())
  name             String
  type             String
  coupon_code      String?   @unique
  value            Float
  min_order_amount Float
  max_discount     Float?
  category_ids     String[]
  product_ids      String[]
  starts_at        DateTime?
  ends_at          DateTime?
  start_hour       Int?
  end_hour         Int?
  is_active        Boolean   @default(true)
  usage_count      Int       @default(0)

  @@map("discounts")
}

model LoyaltyRule {
  id               String  @id @default(uuid())
  visits_required  Int
  discount_percent Float
  reward_points    Int
  expiry_days      Int
  is_active        Boolean @default(true)

  @@map("loyalty_rules")
}

model InventoryItem {
  id                  String    @id @default(uuid())
  name                String
  unit                String
  quantity            Float
  low_stock_threshold Float
  cost_per_unit       Float
  expiry_date         DateTime?

  @@map("inventory_items")
}

model RestaurantTable {
  id           String  @id @default(uuid())
  table_number Int     @unique
  seats        Int
  is_active    Boolean @default(true)

  @@map("restaurant_tables")
}



model Order {
  id              String  @id @default(uuid())
  order_number    String  @unique
  bill_id         String? @unique
  session_token   String
  table_number    Int?
  user_id         String?
  user            User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  customer_name   String?
  customer_phone  String?
  status          OrderStatus @default(PENDING)
  payment_method  String
  payment_status  String
  subtotal        Float
  discount        Float
  discount_label  String?
  tax             Float
  packing_charge  Float
  delivery_charge Float
  total           Float
  notes           String?
  created_at      DateTime @default(now())

  order_items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  order_id     String
  order        Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id   String?
  product      Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  name         String
  unit_price   Float
  quantity     Float
  weight_label String?
  instructions String?
  line_total   Float

  @@map("order_items")
}

model Review {
  id            String   @id @default(uuid())
  product_id    String?
  customer_name String
  rating        Float
  comment       String?
  is_published  Boolean  @default(false)
  created_at    DateTime @default(now())

  @@map("reviews")
}

model Rating {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  userId     String?  // nullable for guest orders
  phone      String   // used to associate guest ratings
  stars      Int      // 1–5
  comment    String?
  createdAt  DateTime @default(now())

  @@map("ratings")
}

model AppNotification {
  id         String   @id @default(uuid())
  type       String
  title      String
  body       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("app_notifications")
}

model PhoneVerification {
  id         String   @id @default(uuid())
  phone      String
  code_hash  String
  attempts   Int      @default(0)
  used       Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("phone_verifications")
}
