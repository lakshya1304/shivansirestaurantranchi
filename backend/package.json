{
  "name": "authservice",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "bun prettier --write .",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:gen": "~/.bun/bin/bun ./node_modules/prisma/build/index.js generate --config=prisma.admin.config.ts && ~/.bun/bin/bun ./node_modules/prisma/build/index.js generate --config=prisma.app.config.ts",
    "db:push:admin": "~/.bun/bin/bun ./node_modules/prisma/build/index.js db push --config=prisma.admin.config.ts",
    "db:push:app": "~/.bun/bin/bun ./node_modules/prisma/build/index.js db push --config=prisma.app.config.ts",
    "build": "tsc",
    "db:push": "bun run db:push:app & bun run db:push:admin",
    "git": "git add . && git commit -m \"kuch toh kiya hu \"&& git push -f origin main"
  },
